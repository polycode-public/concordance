{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx cdk synth:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh api:*)",
      "Bash(gh issue list:*)",
      "Bash(gh workflow list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(scripts/worktree-add.sh:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git rebase -i:*)",
      "Bash(git branch -D main:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main-push.sh",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  }
}
