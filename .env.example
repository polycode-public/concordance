# Local settings. Copy to .env (gitignored). No secrets belong here.

# laptop | bedrock. The laptop path is the build; bedrock is behind the same interface.
MODEL_PROVIDER=laptop

# Postgres from docker-compose.yml
DATABASE_URL=postgres://concordance:concordance@localhost:5432/concordance

# Ollama (OpenAI-compatible endpoint). Models are pulled by `npm run models:pull`.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024
CHAT_MODEL=qwen2.5:7b-instruct
EXTRACT_MODEL=qwen2.5:7b-instruct
# Cross-encoder reranker; models:pull skips it when Ollama does not serve it.
RERANK_MODEL=bge-reranker-v2-m3

# AWS, only for the sandbox stack and the later bedrock provider
AWS_PROFILE=polycode-sandbox
AWS_REGION=eu-west-2

# Bedrock (MODEL_PROVIDER=bedrock). Credentials come from the default AWS chain.
# AWS_REGION above picks the region; the eu. prefix on chat ids is the cross-region inference profile.
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Titan v2 accepts 256, 512 or 1024; the chunk table column must match.
BEDROCK_EMBED_DIM=1024
BEDROCK_CHAT_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EXTRACT_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
